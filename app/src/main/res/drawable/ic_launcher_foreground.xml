                        <item android:offset="0.14" android:color="#FF1A9AD7"/>
                        <item android:offset="0.29" android:color="#FF2F74CD"/>
                        <item android:offset="0.44" android:color="#FF445AD5"/>
                        <item android:offset="0.62" android:color="#FF7A4BDD"/>
