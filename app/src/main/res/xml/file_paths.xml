<?xml version="1.0" encoding="utf-8"?>
<!-- Matches DownloadManager.Request's own setDestinationInExternalFilesDir(
     context, Environment.DIRECTORY_DOWNLOADS, ...) call in
     AppUpdateViewModel: the one real directory this app's own
     FileProvider ever needs to expose a Uri into. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="downloads" path="Download/" />
</paths>
